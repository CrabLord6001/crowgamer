---
interface Props {
  review: {
    verdict: string;
    score?: number;
    played?: string;
    good: string[];
    bad: string[];
    body?: string;
    updated?: Date;
  };
}

const { review: r } = Astro.props;

// timeZone: 'UTC' matters — a bare `2026-11-10` in YAML is UTC midnight, and
// formatting it in the build machine's local zone slides it to the 9th.
const updated = r.updated?.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

const hasLists = r.good.length > 0 || r.bad.length > 0;
---

<section class="review">
  <h2 class="section-title">Review</h2>

  <div class="card">
    <div class="top">
      {
        r.score !== undefined && (
          <div class="score">
            <span class="num">{Number.isInteger(r.score) ? r.score : r.score.toFixed(1)}</span>
            <span class="of">/ 10</span>
          </div>
        )
      }
      <p class="verdict">{r.verdict}</p>
    </div>

    {r.body && <p class="body">{r.body}</p>}

    {
      hasLists && (
        <div class="lists">
          {r.good.length > 0 && (
            <ul class="good">
              {r.good.map((g) => (
                <li>{g}</li>
              ))}
            </ul>
          )}
          {r.bad.length > 0 && (
            <ul class="bad">
              {r.bad.map((bd) => (
                <li>{bd}</li>
              ))}
            </ul>
          )}
        </div>
      )
    }

    {
      (r.played || updated) && (
        <p class="meta">
          {[r.played, updated && `reviewed ${updated}`].filter(Boolean).join(' · ')}
        </p>
      )
    }
  </div>
</section>

<style>
  .review {
    margin-bottom: 28px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 18px 20px;
  }

  .top {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .score {
    flex-shrink: 0;
    display: flex;
    align-items: baseline;
    gap: 3px;
    font-family: var(--mono);
    color: var(--accent);
  }

  .num {
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
  }

  .of {
    font-size: 11px;
    opacity: 0.6;
  }

  .verdict {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.5;
  }

  .body {
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.75;
    color: var(--dim);
    max-width: 70ch;
    white-space: pre-line;
  }

  .lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 6px 24px;
    margin-top: 16px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  li {
    position: relative;
    padding-left: 18px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--dim);
  }

  /* A mark rather than a color alone, so the two lists stay distinguishable
     to anyone who can't separate the greens from the reds. */
  .good li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: #4ade80;
    font-weight: 700;
  }

  .bad li::before {
    content: '−';
    position: absolute;
    left: 0;
    color: #f87171;
    font-weight: 700;
  }

  .meta {
    margin: 16px 0 0;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--dim);
    opacity: 0.7;
  }

  @media (max-width: 560px) {
    .top {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
