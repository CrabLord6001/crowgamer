---
interface Props {
  cta: {
    heading: string;
    body: string;
    button: string;
    href: string;
  };
}
const { cta } = Astro.props;
---

<aside class="cta">
  <div class="copy">
    <h3>{cta.heading}</h3>
    <p>{cta.body}</p>
  </div>
  <a class="button" href={cta.href} target="_blank" rel="noopener noreferrer">
    {cta.button}
  </a>
</aside>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: 32px;
    padding: 18px 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }

  .copy {
    flex: 1 1 260px;
  }

  h3 {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
  }

  p {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--dim);
  }

  .button {
    flex-shrink: 0;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #0a0b0f;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    transition: filter 0.2s, transform 0.2s;
  }

  .button:hover,
  .button:focus-visible {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }
</style>
