---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import SiteSearch from '../components/react/SiteSearch.jsx';
import { fetchProgress } from '../lib/sheet-progress';
import '../styles/search.css';

const games = (await getCollection('games', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// Live completion for the games that track it. Same read the game page does, so
// the number on the card and the number on its page can't drift apart.
const progress = new Map<string, number>();
for (const g of games) {
  const p = g.data.progress;
  if (!p) continue;
  let overall = p.overall;
  if (p.sheetId) {
    const live = await fetchProgress(p.sheetId, p.sheetTab);
    if (live) overall = live.overall;
  }
  progress.set(g.id, overall);
}
---

<Base
  title="CrowGamer — game guides, completion notes and tools"
  description="Personal tools and notes for the games I play, by Jonathan Crow."
>
  <div class="wrap">
    <header class="hero">
      <h1>CrowGamer</h1>
    </header>

    <SiteSearch client:idle />

    <div class="grid">
      {games.map((game) => <GameCard game={game} overall={progress.get(game.id)} />)}
    </div>
  </div>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 60px 0 32px;
  }

  h1 {
    font-size: clamp(32px, 9vw, 42px);
    font-weight: 700;
    margin: 0 0 8px;
    background: linear-gradient(135deg, var(--brand), var(--brand-2), var(--brand));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }



  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 280px));
    justify-content: center;
    gap: 14px;
    padding-bottom: 56px;
  }
</style>
