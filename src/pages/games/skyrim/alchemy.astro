---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import AlchemyLookup from '../../../components/react/AlchemyLookup.jsx';
import { fetchAlchemy } from '../../../lib/alchemy';
import snapshot from '../../../data/alchemy.json';

const game = await getEntry('games', 'skyrim');
const accent = game?.data.accent;

// Effects are fixed game data, so the committed snapshot is the floor. The live
// read only exists so edits to the sheet's "where to find" notes reach the site.
let data = snapshot;
if (game?.data.progress?.sheetId) {
  const live = await fetchAlchemy(game.data.progress.sheetId);
  if (live) data = live;
}

const effectCount = data.effects.length;
const ingredientCount = data.ingredients.length;
---

<Base
  title="Skyrim alchemy — effect and ingredient lookup | CrowGamer"
  description={`Look up any of ${effectCount} Skyrim alchemy effects and see every one of the ${ingredientCount} ingredients that carries it, with value, weight and where to find it. Base game, Dawnguard, Hearthfire and Dragonborn.`}
  accent={accent}
  current="skyrim"
>
  <div class="wrap">
    <header class="hero">
      <a href="/games/skyrim/" class="back">← Skyrim</a>
      <h1>Alchemy lookup</h1>
      <p class="lede">
        {ingredientCount} ingredients, {effectCount} effects. Pick an effect to find every
        ingredient that carries it, or pick an ingredient to see what it combines with.
      </p>
    </header>

    <AlchemyLookup
      client:load
      ingredients={data.ingredients}
      effects={data.effects}
    />

    <p class="note">
      Any two ingredients sharing an effect will brew a potion with it. Which potion you
      actually get depends on your Alchemy skill and perks, so this shows what the pair has
      in common rather than predicting the result. Covers the base game plus Dawnguard,
      Hearthfire and Dragonborn; no Creation Club.
    </p>
  </div>
</Base>

<style>
  .hero {
    padding: 40px 0 24px;
  }
  .back {
    color: var(--dim);
    font-size: 11px;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(26px, 7vw, 34px);
    font-weight: 700;
    margin: 8px 0 8px;
    color: var(--accent);
  }
  .lede {
    font-size: 13px;
    color: var(--dim);
    line-height: 1.7;
    max-width: 640px;
    margin: 0;
  }
  .note {
    max-width: 700px;
    margin: 24px 0 48px;
    font-size: 11px;
    line-height: 1.7;
    color: var(--dim);
    opacity: 0.8;
  }
</style>

<style is:global>
  /* The lookup is a React island, so its styles can't be component-scoped. */
  .alc {
    --row: #11151d;
  }

  .alc-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .alc-modes {
    display: flex;
    gap: 4px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 3px;
  }

  .alc-modes button {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--dim);
    font-family: var(--font);
    font-size: 12px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .alc-modes button:hover {
    color: var(--text);
  }
  .alc-modes button.on {
    color: var(--accent);
    background: var(--accent-dim);
  }

  .alc-dlc,
  .alc-search {
    appearance: none;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font);
    font-size: 12px;
    padding: 8px 12px;
  }
  .alc-dlc:focus-visible,
  .alc-search:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .alc-body {
    display: grid;
    grid-template-columns: minmax(180px, 240px) 1fr;
    gap: 12px;
    align-items: start;
  }

  .alc-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: sticky;
    top: 60px;
  }
  .alc-search {
    width: 100%;
  }

  .alc-options {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 60vh;
    overflow-y: auto;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 6px;
  }

  .alc-opt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: left;
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--dim);
    font-family: var(--font);
    font-size: 12px;
    padding: 7px 9px;
    border-radius: 5px;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .alc-opt:hover {
    color: var(--text);
    background: var(--row);
  }
  .alc-opt.on {
    color: var(--accent);
    background: var(--accent-dim);
  }
  .alc-count {
    font-family: var(--mono);
    font-size: 10px;
    opacity: 0.7;
    flex-shrink: 0;
  }

  .alc-result {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    min-height: 240px;
  }

  .alc-hint,
  .alc-empty {
    color: var(--dim);
    font-size: 12px;
    line-height: 1.7;
    margin: 6px 0;
  }
  .alc-empty {
    padding: 8px 9px;
  }

  .alc-h,
  .alc-h4 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 12px;
    color: var(--accent);
    font-weight: 700;
  }
  .alc-h {
    font-size: 19px;
  }
  .alc-h4 {
    font-size: 13px;
    margin-top: 24px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .alc-sub {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    color: var(--dim);
    letter-spacing: 0;
    text-transform: none;
  }

  .alc-effects {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0 0 12px;
  }
  .alc-effects li {
    display: flex;
    align-items: center;
    gap: 7px;
    background: var(--row);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 5px 10px 5px 6px;
    font-size: 12px;
  }
  .alc-effects .slot {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--bg);
    background: var(--accent);
    border-radius: 3px;
    padding: 1px 5px;
  }

  .alc-src {
    font-size: 11px;
    color: var(--dim);
    margin: 0 0 4px;
    line-height: 1.6;
  }

  .alc-scroll {
    overflow-x: auto;
  }

  .alc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .alc-table th,
  .alc-table td {
    text-align: left;
    padding: 7px 10px 7px 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .alc-table thead th {
    padding-top: 0;
    white-space: nowrap;
  }
  .alc-table tbody th {
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }
  .alc-table .num {
    text-align: right;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--dim);
    white-space: nowrap;
  }
  .alc-table .src {
    color: var(--dim);
    line-height: 1.5;
    min-width: 180px;
  }
  .alc-table tbody tr:hover {
    background: var(--row);
  }
  .alc-table tbody tr:last-child th,
  .alc-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .sortbtn {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--dim);
    font-family: var(--font);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
  }
  .sortbtn:hover,
  .sortbtn.on {
    color: var(--accent);
  }
  .caret {
    margin-left: 3px;
    font-size: 8px;
  }
  .num .sortbtn {
    width: 100%;
    text-align: right;
  }

  .linkish {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    color: inherit;
    font-family: var(--font);
    font-size: inherit;
    cursor: pointer;
    border-bottom: 1px dotted var(--border);
  }
  .linkish:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .dlc {
    display: inline-block;
    margin-left: 6px;
    font-family: var(--mono);
    font-size: 8px;
    color: var(--dim);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 4px;
    vertical-align: middle;
  }

  @media (max-width: 720px) {
    .alc-body {
      grid-template-columns: 1fr;
    }
    .alc-list {
      position: static;
    }
    .alc-options {
      max-height: 240px;
    }
    .alc-table .src {
      min-width: 140px;
    }
  }
</style>
