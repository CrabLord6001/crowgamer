---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import AlchemyLookup from '../../../components/react/AlchemyLookup.jsx';
import { fetchAlchemy } from '../../../lib/alchemy';
import snapshot from '../../../data/alchemy.json';
import '../../../styles/lookup.css';

const game = await getEntry('games', 'skyrim');
const accent = game?.data.accent;

// Effects are fixed game data, so the committed snapshot is the floor. The live
// read only exists so edits to the sheet's "where to find" notes reach the site.
let data = snapshot;
if (game?.data.progress?.sheetId) {
  const live = await fetchAlchemy(game.data.progress.sheetId);
  if (live) data = live;
}

const effectCount = data.effects.length;
const ingredientCount = data.ingredients.length;
---

<Base
  title="Skyrim alchemy — effect and ingredient lookup | CrowGamer"
  description={`Look up any of ${effectCount} Skyrim alchemy effects and see every one of the ${ingredientCount} ingredients that carries it, with value, weight and where to find it. Base game, Dawnguard, Hearthfire and Dragonborn.`}
  accent={accent}
  current="skyrim"
>
  <div class="wrap">
    <header class="hero">
      <a href="/games/skyrim/" class="back">← Skyrim</a>
      <h1>Alchemy lookup</h1>
      <p class="lede">
        {ingredientCount} ingredients, {effectCount} effects. Pick an effect to find every
        ingredient that carries it, or pick an ingredient to see what it combines with.
      </p>
    </header>

    <AlchemyLookup
      client:load
      ingredients={data.ingredients}
      effects={data.effects}
    />

    <p class="note">
      Any two ingredients sharing an effect will brew a potion with it. Which potion you
      actually get depends on your Alchemy skill and perks, so this shows what the pair has
      in common rather than predicting the result. Covers the base game plus Dawnguard,
      Hearthfire and Dragonborn; no Creation Club.
    </p>
  </div>
</Base>

<style>
  .hero {
    padding: 40px 0 24px;
  }
  .back {
    color: var(--dim);
    font-size: 11px;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(26px, 7vw, 34px);
    font-weight: 700;
    margin: 8px 0 8px;
    color: var(--accent);
  }
  .lede {
    font-size: 13px;
    color: var(--dim);
    line-height: 1.7;
    max-width: 640px;
    margin: 0;
  }
  .note {
    max-width: 700px;
    margin: 24px 0 48px;
    font-size: 11px;
    line-height: 1.7;
    color: var(--dim);
    opacity: 0.8;
  }
</style>
