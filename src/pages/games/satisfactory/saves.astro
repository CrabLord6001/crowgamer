---
import ToolPage from '../../../layouts/ToolPage.astro';

// The Airtable view has to stay shared publicly for this embed to render.
const EMBED = 'https://airtable.com/embed/appxctElpzY5nCCkY/shr7ZUbsRo1J8l7eH';
---

<ToolPage
  game="satisfactory"
  title="Satisfactory save tracker | CrowGamer"
  heading="Save Tracker"
  description="To-do list and progress notes for active Satisfactory game saves."
  lede="To-do list and progress notes for active game saves."
>
  <div class="embed">
    <iframe src={EMBED} title="Satisfactory save tracker" loading="lazy"></iframe>
  </div>

  <p class="note">
    Lives in Airtable — <a href={EMBED.replace('/embed/', '/')} target="_blank" rel="noopener noreferrer">open it there</a> to edit.
  </p>
</ToolPage>

<style>
  .embed {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
  }
  .embed iframe {
    display: block;
    width: 100%;
    height: 640px;
    border: 0;
    background: transparent;
  }
  .note {
    margin: 12px 0 48px;
    font-size: 11px;
    color: var(--dim);
  }
  .note a {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
