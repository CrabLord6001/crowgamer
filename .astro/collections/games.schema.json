{
  "$ref": "#/definitions/games",
  "definitions": {
    "games": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "in-progress",
            "planned"
          ],
          "default": "planned"
        },
        "completion": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "hours": {
          "type": "string"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "errorMessage": {
            "pattern": "accent must be a #rrggbb hex color"
          }
        },
        "logo": {
          "type": "string"
        },
        "order": {
          "type": "number",
          "default": 100
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "route": {
                "type": "string"
              },
              "href": {
                "type": "string",
                "format": "uri"
              },
              "ready": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "name",
              "desc",
              "icon"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "tips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "cta": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "button": {
              "type": "string"
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "heading",
            "body",
            "button",
            "href"
          ],
          "additionalProperties": false
        },
        "progress": {
          "type": "object",
          "properties": {
            "updated": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "integer",
                  "format": "unix-time"
                }
              ]
            },
            "source": {
              "type": "string",
              "format": "uri"
            },
            "sheetId": {
              "type": "string"
            },
            "sheetTab": {
              "type": "string",
              "default": "Progress"
            },
            "overall": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "trackers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "done": {
                    "type": "number"
                  },
                  "total": {
                    "type": "number"
                  }
                },
                "required": [
                  "label",
                  "done",
                  "total"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "breakdownLabel": {
              "type": "string"
            },
            "breakdown": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "done": {
                    "type": "number"
                  },
                  "total": {
                    "type": "number"
                  }
                },
                "required": [
                  "name",
                  "done",
                  "total"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "required": [
            "updated",
            "overall"
          ],
          "additionalProperties": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "tagline",
        "genre",
        "summary",
        "accent"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}